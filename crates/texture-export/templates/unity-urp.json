{
  "name": "Unity (URP)",
  "about": "Base map (its alpha the opacity, where the graph has one), a normal map of OpenGL (Y+), metallic with smoothness (1 − roughness) in alpha, and occlusion; height and emission where the graph has them.",
  "normals": "OpenGL",
  "files": [
    {
      "name": "$(graph)_BaseMap",
      "needs": ["base_color", "opacity"],
      "parts": [{ "rgb": { "map": "base_color", "missing": 0.8 } }, { "one": { "map": "opacity", "optional": true } }]
    },
    { "name": "$(graph)_Normal", "needs": ["normal"], "parts": [{ "rgb": { "map": "normal" } }] },
    {
      "name": "$(graph)_MetallicSmoothness",
      "needs": ["ambient_occlusion", "roughness", "metallic"],
      "parts": [{ "rgb": { "map": "metallic", "missing": 0.0 } }, { "one": { "map": "roughness", "invert": true, "missing": 0.5 } }]
    },
    { "name": "$(graph)_Occlusion", "needs": ["ambient_occlusion"], "parts": [{ "one": { "map": "ambient_occlusion" } }] },
    { "name": "$(graph)_Height", "needs": ["height"], "parts": [{ "one": { "map": "height" } }] },
    { "name": "$(graph)_Emission", "needs": ["emissive"], "parts": [{ "rgb": { "map": "emissive" } }] }
  ]
}
