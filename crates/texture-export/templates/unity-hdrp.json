        { "value": { "value": 1.0, "said": "detail mask" } },
        { "one": { "map": "Roughness", "invert": true, "missing": 0.5 } }
      ]
    },
    { "name": "$(graph)_Height", "needs": ["Height"], "parts": [{ "one": { "map": "Height" } }] },
    { "name": "$(graph)_Emission", "needs": ["Emissive"], "parts": [{ "rgb": { "map": "Emissive" } }] }
  ]
