{
  "name": "Unity (HDRP)",
  "about": "Base map (its alpha the opacity, where the graph has one), a normal map of OpenGL (Y+), and the mask map: metallic, occlusion, detail mask and smoothness (1 − roughness); height and emission where the graph has them.",
  "normals": "OpenGL",
  "files": [
    {
      "name": "$(graph)_BaseMap",
      "needs": ["base_color", "opacity"],
      "parts": [{ "rgb": { "map": "base_color", "missing": 0.8 } }, { "one": { "map": "opacity", "optional": true } }]
    },
    { "name": "$(graph)_Normal", "needs": ["normal"], "parts": [{ "rgb": { "map": "normal" } }] },
    {
      "name": "$(graph)_MaskMap",
      "needs": ["ambient_occlusion", "roughness", "metallic"],
      "parts": [
        { "one": { "map": "metallic", "missing": 0.0 } },
        { "one": { "map": "ambient_occlusion", "missing": 1.0 } },
        { "value": { "value": 1.0, "said": "detail mask" } },
        { "one": { "map": "roughness", "invert": true, "missing": 0.5 } }
      ]
    },
    { "name": "$(graph)_Height", "needs": ["height"], "parts": [{ "one": { "map": "height" } }] },
    { "name": "$(graph)_Emission", "needs": ["emissive"], "parts": [{ "rgb": { "map": "emissive" } }] }
  ]
}
