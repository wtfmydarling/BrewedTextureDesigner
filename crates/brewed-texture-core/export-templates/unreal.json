{
  "name": "Unreal Engine",
  "about": "Base color (its alpha the opacity, where the graph has one), a normal map of DirectX (Y−), and occlusion, roughness and metallic packed in red, green and blue (ORM), named T_<graph>_…; height and emissive where the graph has them.",
  "normals": "DirectX",
  "files": [
    {
      "name": "T_$(graph)_BaseColor",
      "needs": ["base_color", "opacity"],
      "parts": [{ "rgb": { "map": "base_color", "missing": 0.8 } }, { "one": { "map": "opacity", "optional": true } }]
    },
    { "name": "T_$(graph)_Normal", "needs": ["normal"], "parts": [{ "rgb": { "map": "normal", "normals": "DirectX" } }] },
    {
      "name": "T_$(graph)_ORM",
      "needs": ["ambient_occlusion", "roughness", "metallic"],
      "parts": [
        { "one": { "map": "ambient_occlusion", "missing": 1.0 } },
        { "one": { "map": "roughness", "missing": 0.5 } },
        { "one": { "map": "metallic", "missing": 0.0 } }
      ]
    },
    { "name": "T_$(graph)_Height", "needs": ["height"], "parts": [{ "one": { "map": "height" } }] },
    { "name": "T_$(graph)_Emissive", "needs": ["emissive"], "parts": [{ "rgb": { "map": "emissive" } }] }
  ]
}
